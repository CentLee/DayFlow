#!/usr/bin/env bash
set -euo pipefail

url=''
payload=''
method='GET'
args=("$@")
for ((index = 0; index < ${#args[@]}; index++)); do
  case "${args[$index]}" in
    -X)
      method="${args[$((index + 1))]}"
      ;;
    --data)
      payload="${args[$((index + 1))]}"
      ;;
    http://*|https://*)
      url="${args[$index]}"
      ;;
  esac
done

printf '%s %s\n' "$method" "$url" >>"${FAKE_MERGE_CURL_LOG:?}"

increment_counter() {
  local file="$1"
  local current=0
  [[ ! -f "$file" ]] || current="$(<"$file")"
  printf '%s\n' "$((current + 1))" >"$file"
}

if [[ "$url" == "${DAYFLOW_LINEAR_API_URL:?}" ]]; then
  if [[ "$payload" == *'UpdateIssueState'* ]]; then
    increment_counter "${FAKE_LINEAR_MUTATION_COUNT:?}"
    [[ "${FAKE_LINEAR_MUTATION_FAIL:-false}" != "true" ]] || {
      printf '%s\n' '{"data":{"issueUpdate":{"success":false,"issue":{"id":"linear-30","state":{"name":"In Review"}}}}}'
      exit 0
    }
    printf '%s\n' 'Done' >"${FAKE_LINEAR_STATE_FILE:?}"
    printf '%s\n' '{"data":{"issueUpdate":{"success":true,"issue":{"id":"linear-30","state":{"name":"Done"}}}}}'
  else
    state='In Review'
    [[ ! -f "${FAKE_LINEAR_STATE_FILE:?}" ]] || state="$(<"$FAKE_LINEAR_STATE_FILE")"
    jq -cn --arg state "$state" '{data: {issue: {id: "linear-30", identifier: "CEN-30", state: {name: $state}, team: {states: {nodes: [{id: "done-state", name: "Done"}]}}}}}'
  fi
elif [[ "$url" == *'/comments?per_page='* ]]; then
  [[ "${FAKE_GITHUB_LIST_FAIL:-false}" != "true" ]] || exit 22
  if [[ -f "${FAKE_GITHUB_MARKER_FILE:?}" ]]; then
    jq -cn --arg body "$(<"$FAKE_GITHUB_MARKER_FILE")" '[{body: $body, user: {login: "github-actions[bot]"}}]'
  else
    printf '%s\n' '[]'
  fi
elif [[ "$url" == *'/comments' && "$method" == 'POST' ]]; then
  increment_counter "${FAKE_GITHUB_COMMENT_COUNT:?}"
  [[ "${FAKE_GITHUB_COMMENT_FAIL:-false}" != "true" ]] || exit 22
  jq -r '.body' <<<"$payload" >"${FAKE_GITHUB_MARKER_FILE:?}"
  printf '%s\n' '{"id":123}'
elif [[ "$url" == "${DAYFLOW_DISCORD_WEBHOOK_URL:?}" ]]; then
  increment_counter "${FAKE_DISCORD_COUNT:?}"
  if [[ -f "${FAKE_DISCORD_FAILURES_FILE:?}" ]]; then
    failures="$(<"$FAKE_DISCORD_FAILURES_FILE")"
    if (( failures > 0 )); then
      printf '%s\n' "$((failures - 1))" >"$FAKE_DISCORD_FAILURES_FILE"
      exit 22
    fi
  fi
  printf '%s\n' '{}'
else
  printf 'unexpected fake curl request: %s %s\n' "$method" "$url" >&2
  exit 1
fi
