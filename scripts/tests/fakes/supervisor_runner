#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"${FAKE_SUPERVISOR_RUNNER_LOG:?}"
case "${1:-}" in
  reconcile)
    if [[ -n "${FAKE_SUPERVISOR_RECONCILE_DONE_KEY:-}" ]]; then
      tmp="${DAYFLOW_SUPERVISOR_ISSUES_FILE}.tmp.$$"
      jq --arg key "$FAKE_SUPERVISOR_RECONCILE_DONE_KEY" \
        '(.issues[] | select(.identifier == $key) | .state) = "Done"
         | (.issues[].blockers[]? | select(.identifier == $key) | .state) = "Done"' \
        "$DAYFLOW_SUPERVISOR_ISSUES_FILE" >"$tmp"
      mv "$tmp" "$DAYFLOW_SUPERVISOR_ISSUES_FILE"
    fi
    ;;
  run)
    issue_key="${2:?}"
    mkdir -p "$DAYFLOW_STATE_ROOT"
    jq -n --arg issue "$issue_key" '{issue: $issue, status: "in-review"}' >"$DAYFLOW_STATE_ROOT/${issue_key}.json"
    ;;
  *)
    exit 2
    ;;
esac
