#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"${FAKE_CURL_LOG:?}"
if [[ "$*" == *"api.linear.app"* || "$*" == *"linear.test"* ]]; then
  if [[ -n "${FAKE_LINEAR_FAIL_STATE:-}" && "$*" == *"${FAKE_LINEAR_FAIL_STATE}"* ]]; then
    printf '%s\n' '{"data":{"issueUpdate":{"success":false}}}'
    exit 0
  fi
  printf '%s\n' '{"data":{"issueUpdate":{"success":true}}}'
else
  if [[ "$*" == *"merge-ready"* && -n "${FAKE_WEBHOOK_FAILURES_FILE:-}" ]]; then
    failures="$(<"$FAKE_WEBHOOK_FAILURES_FILE")"
    if (( failures > 0 )); then
      printf '%s\n' "$((failures - 1))" >"$FAKE_WEBHOOK_FAILURES_FILE"
      exit 22
    fi
  fi
  if [[ -n "${FAKE_WEBHOOK_DELAY_SECONDS:-}" ]]; then
    sleep "$FAKE_WEBHOOK_DELAY_SECONDS"
  fi
  printf '%s\n' '{}'
fi
