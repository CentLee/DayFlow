#!/usr/bin/env bash
set -euo pipefail

url=''
payload=''
method='GET'
write_out=''
args=("$@")
for ((index = 0; index < ${#args[@]}; index++)); do
  case "${args[$index]}" in
    -X) method="${args[$((index + 1))]}" ;;
    --data) payload="${args[$((index + 1))]}" ;;
    --write-out|-w) write_out="${args[$((index + 1))]}" ;;
    http://*|https://*) url="${args[$index]}" ;;
  esac
done

increment() {
  local file="$1" current=0
  [[ ! -f "$file" ]] || current="$(<"$file")"
  printf '%s\n' "$((current + 1))" >"$file"
}

comments() {
  [[ -f "${FAKE_READY_COMMENTS:?}" ]] && cat "$FAKE_READY_COMMENTS" || printf '[]\n'
}

save_comments() {
  printf '%s\n' "$1" >"${FAKE_READY_COMMENTS:?}"
}

printf '%s %s\n' "$method" "$url" >>"${FAKE_READY_CURL_LOG:?}"

if [[ "$url" == *'/pulls/46' && "$method" == 'GET' ]]; then
  if [[ "${FAKE_READY_PR_VARIANT:-eligible}" == 'draft' ]]; then
    printf '%s\n' '{"state":"open","draft":true,"base":{"ref":"develop"},"head":{"sha":"0123456789abcdef0123456789abcdef01234567","repo":{"full_name":"CentLee/DayFlow"},"ref":"feature/tasks-46-notify-discord-when-a-task-pr-is-merge-ready"}}'
  else
    printf '%s\n' '{"state":"open","draft":false,"base":{"ref":"develop"},"head":{"sha":"0123456789abcdef0123456789abcdef01234567","repo":{"full_name":"CentLee/DayFlow"},"ref":"feature/tasks-46-notify-discord-when-a-task-pr-is-merge-ready"}}'
  fi
elif [[ "$url" == *'/actions/runs?'* && "$method" == 'GET' ]]; then
  case "${FAKE_READY_CI_STATE:-success}" in
    success) printf '%s\n' '{"workflow_runs":[{"name":"Harness CI","event":"pull_request","head_sha":"0123456789abcdef0123456789abcdef01234567","status":"completed","conclusion":"success","run_attempt":1,"created_at":"2026-08-20T00:00:00Z"}]}' ;;
    waiting) printf '%s\n' '{"workflow_runs":[{"name":"API CI","event":"pull_request","head_sha":"0123456789abcdef0123456789abcdef01234567","status":"in_progress","conclusion":null,"run_attempt":1,"created_at":"2026-08-20T00:00:00Z"}]}' ;;
    failed) printf '%s\n' '{"workflow_runs":[{"name":"API CI","event":"pull_request","head_sha":"0123456789abcdef0123456789abcdef01234567","status":"completed","conclusion":"failure","run_attempt":1,"created_at":"2026-08-20T00:00:00Z"}]}' ;;
    *) exit 1 ;;
  esac
elif [[ "$url" == *'/comments?per_page='* && "$method" == 'GET' ]]; then
  comments
elif [[ "$url" == *'/issues/46/comments' && "$method" == 'POST' ]]; then
  increment "${FAKE_READY_COMMENT_CREATE_COUNT:?}"
  body="$(jq -r '.body' <<<"$payload")"
  current="$(comments)"
  next_id="$(jq '[.[].id] | max // 500 | . + 1' <<<"$current")"
  current="$(jq -c --argjson id "$next_id" --arg body "$body" '. + [{id: $id, body: $body, user: {login: "github-actions[bot]"}}]' <<<"$current")"
  save_comments "$current"
  jq -cn --argjson id "$next_id" --arg body "$body" '{id: $id, body: $body}'
elif [[ "$url" == *'/issues/comments/'* && "$method" == 'PATCH' ]]; then
  increment "${FAKE_READY_COMMENT_UPDATE_COUNT:?}"
  id="${url##*/}"
  body="$(jq -r '.body' <<<"$payload")"
  current="$(comments)"
  current="$(jq -c --argjson id "$id" --arg body "$body" 'map(if .id == $id then .body = $body else . end)' <<<"$current")"
  save_comments "$current"
  jq -cn --argjson id "$id" --arg body "$body" '{id: $id, body: $body}'
elif [[ "$url" == "${DAYFLOW_DISCORD_WEBHOOK_URL:?}" && "$method" == 'POST' ]]; then
  increment "${FAKE_READY_DISCORD_COUNT:?}"
  [[ "${FAKE_READY_DISCORD_REJECT:-false}" != 'true' ]] || {
    printf '%s' '500'
    exit 0
  }
  [[ -z "$write_out" ]] || printf '%s' '204'
else
  printf 'unexpected fake curl request: %s %s\n' "$method" "$url" >&2
  exit 1
fi
